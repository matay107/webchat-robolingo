# LINE Developers Console → your Messaging API channel
LINE_CHANNEL_SECRET=        # Basic settings → Channel secret (32 hex chars)
LINE_CHANNEL_ACCESS_TOKEN=  # Messaging API → Channel access token (long-lived)

# Postgres (Neon via Vercel Storage). Use the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin login. Generate with: pnpm hash-password
ADMIN_PASSWORD_HASH=

# Session signing key. Generate with: openssl rand -base64 48
SESSION_SECRET=
